{
  "model": "nvidia/Qwen3.8-Flash-Next-NVFP4",
  "tokenizer": "nvidia/Qwen3.8-Flash-Next-NVFP4",
  "revision": "fc694b54fb0174e0913e6adf86691ef85a4ead47",
  "tokenizer_revision": "fc694b54fb0174e0913e6adf86691ef85a4ead47",
  "trust_remote_code": true,
  "runner": "generate",
  "quantization": "modelopt_mixed",
  "dtype": "bfloat16",
  "kv_cache_dtype": "fp8_e4m3",
  "mamba_cache_dtype": "bfloat16",
  "mamba_cache_mode": "align",
  "load_format": "safetensors",
  "safetensors_load_strategy": "lazy",
  "enforce_eager": false,
  "gpu_memory_utilization": 0.85,
  "max_model_len": 262144,
  "max_num_seqs": 4,
  "max_num_batched_tokens": 8192,
  "tensor_parallel_size": 1,
  "pipeline_parallel_size": 1,
  "data_parallel_size": 1,
  "async_scheduling": false,
  "enable_prefix_caching": true,
  "enable_chunked_prefill": true,
  "disable_chunked_mm_input": false,
  "limit_mm_per_prompt": {
    "image": 2,
    "video": 0
  },
  "mm_processor_kwargs": {
    "truncation": false
  },
  "disable_log_stats": false,
  "engram_config": {
    "cpu_offload": false
  },
  "additional_config": {
    "ple_storage": "mmap",
    "fuzev": {
      "enabled": true
    }
  },
  "speculative_config": {
    "method": "mtp",
    "num_speculative_tokens": 3
  },
  "per_request_spec_decode_metrics": "summary",
  "compilation_config": {
    "cudagraph_mode": "PIECEWISE",
    "splitting_ops": [
      "vllm::unified_attention_with_output",
      "vllm::unified_mla_attention_with_output",
      "vllm::mamba_mixer2",
      "vllm::mamba_mixer",
      "vllm::short_conv",
      "vllm::qwen4_exp_ple_short_conv",
      "vllm::qwen4_exp_qsa_with_output",
      "vllm::linear_attention",
      "vllm::qwen_gdn_attention_core",
      "vllm::qwen_gdn_attention_core_fused_norm_packed",
      "vllm::gdn_attention_core_xpu",
      "vllm::olmo_hybrid_gdn_full_forward",
      "vllm::sparse_attn_indexer",
      "vllm::rocm_aiter_sparse_attn_indexer",
      "vllm::deepseek_v4_attention",
      "vllm::hpc_rope_norm_forward",
      "vllm::unified_kv_cache_update",
      "vllm::unified_mla_kv_cache_update",
      "vllm::qwen4_exp_ple_mmap_lookup_out"
    ]
  }
}
